# Export the selected dependency once for the original native makefiles.
function(sevenzip_crypto_json_array output)
    set(items)
    foreach(value IN LISTS ARGN)
        string(REPLACE "\\" "\\\\" value "${value}")
        string(REPLACE "\"" "\\\"" value "${value}")
        list(APPEND items "\"${value}\"")
    endforeach()
    list(JOIN items "," joined)
    set(${output} "[${joined}]" PARENT_SCOPE)
endfunction()

set(crypto_runtime_provider OPENSSL)
set(crypto_runtime_version "${OPENSSL_VERSION}")
set(crypto_runtime_definitions SEVENZIP_OPENSSL_HASHES)
set(crypto_runtime_includes "${OPENSSL_INCLUDE_DIR}")
set(crypto_runtime_libraries)
list(APPEND crypto_runtime_libraries "$<TARGET_FILE:OpenSSL::Crypto>")
get_target_property(crypto_runtime_extra OpenSSL::Crypto INTERFACE_LINK_LIBRARIES)
if(crypto_runtime_extra)
    foreach(dependency IN LISTS crypto_runtime_extra)
        string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" dependency "${dependency}")
        if(dependency STREQUAL "Threads::Threads")
            separate_arguments(crypto_runtime_threads NATIVE_COMMAND "${CMAKE_THREAD_LIBS_INIT}")
            list(APPEND crypto_runtime_libraries ${crypto_runtime_threads})
        elseif(TARGET "${dependency}")
            list(APPEND crypto_runtime_libraries "$<TARGET_FILE:${dependency}>")
        elseif(dependency MATCHES "\\$<")
            message(FATAL_ERROR "Unsupported native crypto link expression: ${dependency}")
        else()
            list(APPEND crypto_runtime_libraries "${dependency}")
        endif()
    endforeach()
endif()
sevenzip_crypto_json_array(crypto_runtime_definitions_json ${crypto_runtime_definitions})
sevenzip_crypto_json_array(crypto_runtime_includes_json ${crypto_runtime_includes})
sevenzip_crypto_json_array(crypto_runtime_libraries_json ${crypto_runtime_libraries})
file(GENERATE OUTPUT "${CMAKE_CURRENT_SOURCE_DIR}/build/crypto-provider.json" CONTENT
"{\n\"schema\":1,\n\"provider\":\"${crypto_runtime_provider}\",\n\"version\":\"${crypto_runtime_version}\",\n\"system\":\"${CMAKE_SYSTEM_NAME}\",\n\"deployment_target\":\"${CMAKE_OSX_DEPLOYMENT_TARGET}\",\n\"definitions\":${crypto_runtime_definitions_json},\n\"includes\":${crypto_runtime_includes_json},\n\"libraries\":${crypto_runtime_libraries_json}\n}\n")
