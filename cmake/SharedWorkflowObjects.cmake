# Compile common presentation/test support once with its own narrow settings.
# Per-test definitions remain on test sources; these modules do not consume them.
get_property(sevenzip_workflow_consumers DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
function(sevenzip_share_workflow_object owner source)
    add_library(${owner} OBJECT ${source})
    target_include_directories(${owner} PRIVATE src src/CPP third_party/7zip/CPP tests)
    target_link_libraries(${owner} PRIVATE Qt6::Widgets sevenzip_common)
    set_target_properties(${owner} PROPERTIES AUTOMOC OFF AUTOUIC OFF)
    foreach(consumer IN LISTS sevenzip_workflow_consumers)
        get_target_property(consumer_sources ${consumer} SOURCES)
        if("${source}" IN_LIST consumer_sources)
            list(REMOVE_ITEM consumer_sources "${source}")
            set_property(TARGET ${consumer} PROPERTY SOURCES "${consumer_sources}")
            target_sources(${consumer} PRIVATE $<TARGET_OBJECTS:${owner}>)
        endif()
    endforeach()
endfunction()

sevenzip_share_workflow_object(sevenzip_panel_context_menu src/qtpanelcontextmenu.cpp)
if(BUILD_TESTING)
    sevenzip_share_workflow_object(sevenzip_layout_inspection tests/layout_inspection.cpp)
    sevenzip_share_workflow_object(sevenzip_widget_dialog_fixtures tests/fixtures/widget_dialogs.cpp)
    sevenzip_share_workflow_object(sevenzip_panel_load_fixture tests/panel_load_folder.cpp)
endif()
