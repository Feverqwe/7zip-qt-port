  "behavioralTests": {
    "ctest": "^(progress_dialog|progress_priority|progress_priority_failure|progress_worker|progress_cancel|update_callback|archive_progress)$",
    "CProgressDialog::OnPriorityButton": "sourceTransitionDefaultFocusAndGeometry; nativeExternalPolicyRejectsForegroundAndAllowsRetry (Darwin): native policy, caption/title, default Enter, focused Pause Enter, real refusal rollback/report/retry",
    "CProgressDialog::UpdateStatInfo": "initialUnknownStateAndSourceCommands; countersRatioTitleAndUnicodePath; decompressingAndFilesProgress",
    "CProgressDialog::SetProgressRange": "sourceRangeConverterAndBackwardProgress: zero, 32767/32768, 64-bit range, completion and backward reset; nativeProgressControlClampsOutOfRangePosition checks native control boundary semantics",
    "CProgressDialog::OnPauseButton": "pauseStopsRenderingAndPreservesElapsedTime",
    "CProgressDialog::UpdateMessagesDialog": "errorLinesAppendNumberingAndClipboard",
    "CProgressDialog::OnInit": "sourceIconIDAndEmbeddedFrames: conditional default/source/invalid ID and native embedded image frames; sourceLayoutStates covers normal/compact states",
    "CProgressDialog::OnExternalCloseMessage": "sourceErrorListCloseState: native completion, normal/compact Close geometry/default/Enter, hidden Pause/Background; source modal results, final messages and worker exception composition",
    "CProgressDialog::OnButtonClicked": "progress_cancel: YES/NO/CANCEL/Escape, prior pause restoration and native finish deferred while the confirmation is open",
    "scope": "Integrated source modal/worker/cancel/callback component and first ArchiveBackend Add/drop consumer were accepted in P0-10.1. P0-10.2 connects the remaining current archive/filesystem/volume consumers and source MessagesDialog. Geometry and decoded icon frames are not Windows pixel parity."
