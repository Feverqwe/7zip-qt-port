# Qt presentation adapter for the single-line STRINGTABLE syntax used by the
# pinned upstream resources. Generate build output only; reject unhandled syntax.
cmake_minimum_required(VERSION 3.21)
if(NOT DEFINED RESOURCE_FILES OR NOT DEFINED OUTPUT_FILE)
    message(FATAL_ERROR "RESOURCE_FILES and OUTPUT_FILE are required")
endif()

set(entries "")
foreach(mixed_file IN LISTS MIXED_RESOURCE_FILES)
    if(NOT mixed_file IN_LIST RESOURCE_FILES)
        message(FATAL_ERROR "Mixed resource must be a declared input: ${mixed_file}")
    endif()
endforeach()
foreach(resource_file IN LISTS RESOURCE_FILES)
    set(mixed_resource FALSE)
    if(resource_file IN_LIST MIXED_RESOURCE_FILES)
        set(mixed_resource TRUE)
    endif()
    file(STRINGS "${resource_file}" resource_lines ENCODING UTF-8)
    set(in_table FALSE)
    set(expect_begin FALSE)
    set(table_seen FALSE)
    foreach(line IN LISTS resource_lines)
        string(STRIP "${line}" line)
        if(line STREQUAL "" OR line MATCHES "^//")
            continue()
        endif()
        if(line MATCHES "^STRINGTABLE( DISCARDABLE)?$")
            if(in_table OR expect_begin)
                message(FATAL_ERROR "Nested STRINGTABLE in ${resource_file}")
            endif()
            set(expect_begin TRUE)
        elseif(expect_begin)
            if(NOT line STREQUAL "BEGIN")
                message(FATAL_ERROR "Expected STRINGTABLE BEGIN in ${resource_file}")
            endif()
            set(in_table TRUE)
            set(expect_begin FALSE)
            set(table_seen TRUE)
        elseif(in_table)
            if(line STREQUAL "END")
                set(in_table FALSE)
            elseif(line MATCHES "^(IDS_[A-Z0-9_]+)[ \t]+(\"[^\"]*\")$")
                string(APPEND entries "    {${CMAKE_MATCH_1}, L${CMAKE_MATCH_2}},\n")
            else()
                message(FATAL_ERROR "Unsupported STRINGTABLE line in ${resource_file}: ${line}")
            endif()
        elseif(NOT mixed_resource AND NOT line MATCHES "^#include \"[^\"]+\"$" AND
               NOT line STREQUAL "LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US")
            message(FATAL_ERROR "Unsupported resource syntax in ${resource_file}: ${line}")
        endif()
    endforeach()
    if(in_table OR expect_begin OR NOT table_seen)
        message(FATAL_ERROR "Incomplete STRINGTABLE in ${resource_file}")
    endif()
endforeach()
if(entries STREQUAL "")
    message(FATAL_ERROR "No resource strings found")
endif()

set(content "// Generated from pinned upstream STRINGTABLE resources. Do not edit.\n")
string(APPEND content "static const ResourceStringEntry kResourceStrings[] = {\n${entries}};\n")
file(WRITE "${OUTPUT_FILE}.tmp" "${content}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
    "${OUTPUT_FILE}.tmp" "${OUTPUT_FILE}" COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${OUTPUT_FILE}.tmp")
