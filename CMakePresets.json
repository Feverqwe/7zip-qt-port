{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "generator": "Ninja",
      "binaryDir": "$env{SEVENZIP_BUILD_ROOT}/dev",
      "condition": { "type": "notEquals", "lhs": "$env{SEVENZIP_BUILD_ROOT}", "rhs": "" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "$env{SEVENZIP_BUILD_ROOT}/release",
      "condition": { "type": "notEquals", "lhs": "$env{SEVENZIP_BUILD_ROOT}", "rhs": "" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "modules-dev",
      "inherits": "dev",
      "displayName": "Development with C++23 dependency modules",
      "binaryDir": "$env{SEVENZIP_BUILD_ROOT}/modules-dev",
      "cacheVariables": {
        "SEVENZIP_ENABLE_DEPENDENCY_MODULES": "ON"
      }
    },
    {
      "name": "modules-linux-dev",
      "inherits": "modules-dev",
      "displayName": "Development with Clang 19 dependency modules on Linux",
      "binaryDir": "$env{SEVENZIP_BUILD_ROOT}/modules-linux-dev",
      "condition": {
        "type": "allOf",
        "conditions": [
          { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
          { "type": "notEquals", "lhs": "$env{SEVENZIP_BUILD_ROOT}", "rhs": "" }
        ]
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-19",
        "CMAKE_CXX_COMPILER": "clang++-19"
      }
    },
    {
      "name": "modules-gcc-dev",
      "inherits": "modules-dev",
      "displayName": "Development with GCC and C++23 library features",
      "binaryDir": "$env{SEVENZIP_BUILD_ROOT}/modules-gcc-dev"
    },
    {
      "name": "vcpkg-dev",
      "inherits": "dev",
      "displayName": "Development with vcpkg",
      "binaryDir": "$env{SEVENZIP_BUILD_ROOT}/vcpkg-dev",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {}
    },
    {
      "name": "vcpkg-release",
      "inherits": "release",
      "displayName": "Release with vcpkg",
      "binaryDir": "$env{SEVENZIP_BUILD_ROOT}/vcpkg-release",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {}
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "modules-dev", "configurePreset": "modules-dev" },
    { "name": "modules-linux-dev", "configurePreset": "modules-linux-dev" },
    { "name": "modules-gcc-dev", "configurePreset": "modules-gcc-dev" },
    { "name": "vcpkg-dev", "configurePreset": "vcpkg-dev" },
    { "name": "vcpkg-release", "configurePreset": "vcpkg-release" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "modules-dev", "configurePreset": "modules-dev", "output": { "outputOnFailure": true } },
    { "name": "modules-linux-dev", "configurePreset": "modules-linux-dev", "output": { "outputOnFailure": true } },
    { "name": "modules-gcc-dev", "configurePreset": "modules-gcc-dev", "output": { "outputOnFailure": true } },
    { "name": "vcpkg-dev", "configurePreset": "vcpkg-dev", "output": { "outputOnFailure": true } }
  ]
}
