{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SEVENZIP_CODEC_RUNTIME_DIR": "${sourceDir}/build/codec-runtime",
        "SEVENZIP_SFX_RUNTIME_DIR": "${sourceDir}/build/sfx",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "modules-dev",
      "inherits": "dev",
      "displayName": "Development with C++23 dependency modules",
      "binaryDir": "${sourceDir}/build/modules-dev",
      "cacheVariables": {
        "SEVENZIP_ENABLE_DEPENDENCY_MODULES": "ON",
        "SEVENZIP_CODEC_RUNTIME_DIR": "${sourceDir}/build/${presetName}/codec-runtime",
        "SEVENZIP_SFX_RUNTIME_DIR": "${sourceDir}/build/${presetName}/sfx"
      }
    },
    {
      "name": "modules-linux-dev",
      "inherits": "modules-dev",
      "displayName": "Development with Clang 18 dependency modules on Linux",
      "binaryDir": "${sourceDir}/build/modules-linux-dev",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18"
      }
    },
    {
      "name": "modules-gcc-dev",
      "inherits": "modules-dev",
      "displayName": "Development with GCC and C++23 library features",
      "binaryDir": "${sourceDir}/build/modules-gcc-dev"
    },
    {
      "name": "vcpkg-dev",
      "inherits": "dev",
      "displayName": "Development with vcpkg",
      "binaryDir": "${sourceDir}/build/vcpkg-dev",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "SEVENZIP_CODEC_RUNTIME_DIR": "${sourceDir}/build/${presetName}/codec-runtime",
        "SEVENZIP_SFX_RUNTIME_DIR": "${sourceDir}/build/${presetName}/sfx"
      }
    },
    {
      "name": "vcpkg-release",
      "inherits": "release",
      "displayName": "Release with vcpkg",
      "binaryDir": "${sourceDir}/build/vcpkg-release",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "modules-dev", "configurePreset": "modules-dev" },
    { "name": "modules-linux-dev", "configurePreset": "modules-linux-dev" },
    { "name": "modules-gcc-dev", "configurePreset": "modules-gcc-dev" },
    { "name": "vcpkg-dev", "configurePreset": "vcpkg-dev" },
    { "name": "vcpkg-release", "configurePreset": "vcpkg-release" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "modules-dev", "configurePreset": "modules-dev", "output": { "outputOnFailure": true } },
    { "name": "modules-linux-dev", "configurePreset": "modules-linux-dev", "output": { "outputOnFailure": true } },
    { "name": "modules-gcc-dev", "configurePreset": "modules-gcc-dev", "output": { "outputOnFailure": true } },
    { "name": "vcpkg-dev", "configurePreset": "vcpkg-dev", "output": { "outputOnFailure": true } }
  ]
}
